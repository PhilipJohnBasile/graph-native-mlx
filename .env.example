# Direct MLX-LM mode
GRAPH_MODEL_MLX_MODEL=AutomatosX/AX-Qwen3.8-27B-MLX-AXQ-6bit-MTP
# GRAPH_MODEL_MLX_ADAPTER_PATH=/absolute/path/to/adapter
# GRAPH_MODEL_MLX_REVISION=<hugging-face-commit-sha>
GRAPH_MODEL_MLX_MAX_TOKENS=8192
GRAPH_MODEL_MLX_TEMPERATURE=0.1
GRAPH_MODEL_MLX_TOP_P=1.0
GRAPH_MODEL_MLX_MIN_P=0.0
GRAPH_MODEL_MLX_TOP_K=0
GRAPH_MODEL_MLX_LAZY_LOAD=false
GRAPH_MODEL_MLX_TRUST_REMOTE_CODE=false
# GRAPH_MODEL_MLX_POLICY_WEIGHTS=/absolute/path/to/graph_policy.safetensors
# GRAPH_MODEL_MLX_POLICY_CONFIG=/absolute/path/to/graph_policy.json
GRAPH_MODEL_MLX_POLICY_SCALE=1.0

# OpenAI-compatible fallback / comparison mode
GRAPH_MODEL_BASE_URL=http://127.0.0.1:8000/v1
GRAPH_MODEL_NAME=Qwen3.8-27B-JANG_4L
GRAPH_MODEL_API_KEY=local
GRAPH_MODEL_TIMEOUT_SECONDS=300
GRAPH_MODEL_TEMPERATURE=0.1
GRAPH_MODEL_JSON_MODE=auto

# Durable state
GRAPH_MODEL_DB=.graph-model/runs.sqlite3

# Legacy hashed route controller
# GRAPH_MODEL_ROUTER_PATH=models/router-v1.json
GRAPH_MODEL_ROUTER_MIN_CONFIDENCE=0.60

# Optional Restate service
GRAPH_RESTATE_BIND=0.0.0.0:9080
